<?xml version="1.0" encoding="utf-8"?>
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">
	<Type Name="frost::StringLiteral">
		<DisplayString>{m_ptr,[m_len]s8}</DisplayString>
		<StringView>m_ptr,[m_len]s8</StringView>
		<Expand>
			<Item Name="[length]">m_len</Item>
			<Item Name="[ptr]">(const void*)m_ptr</Item>
		</Expand>
	</Type>
	<Type Name="frost::StringView">
		<DisplayString>{m_ptr,[m_len]s8}</DisplayString>
		<StringView>m_ptr,[m_len]s8</StringView>
		<Expand>
			<Item Name="[length]">m_len</Item>
			<Item Name="[0terminated]">m_0terminated</Item>
			<Item Name="[ptr]">(const void*)m_ptr</Item>
		</Expand>
	</Type>
	<Type Name="frost::StringT&lt;*&gt;">
		<DisplayString>{m_ptr,[m_len]s8}</DisplayString>
		<StringView>m_ptr,[m_len]s8</StringView>
		<Expand>
			<Item Name="[length]">m_len</Item>
			<Item Name="[capacity]">m_capacity</Item>
			<Item Name="[ptr]">(const void*)m_ptr</Item>
		</Expand>
	</Type>
	<Type Name="frost::HandleAlloc">
		<DisplayString>{{ handles={m_numHandles}/{m_maxHandles} }}</DisplayString>
		<Expand>
			<Item Name="[numHandles]">m_numHandles</Item>
			<Item Name="[maxHandles]">m_maxHandles</Item>
			<ArrayItems>
				<Size>m_numHandles</Size>
				<ValuePointer>(unsigned short*)(this+1)</ValuePointer>
			</ArrayItems>
		</Expand>
	</Type>

	<Type Name="frost::HandleAlloc2">
		<DisplayString>{{ handles={m_numHandles}/{m_maxHandles} }}</DisplayString>
		<Expand>
			<Item Name="[numHandles]">m_numHandles</Item>
			<Item Name="[maxHandles]">m_maxHandles</Item>
			<Item Name="[bits]">m_bits</Item>
			<CustomListItems MaxItemsPerView="4096">
				<Variable Name="idx" InitialValue="0" />
				<Loop Condition="idx &lt; m_maxHandles">
					<If Condition="(m_bits.m_ptr[idx / 64] &gt;&gt; (idx % 64)) &amp; 1">
						<Item Name="[{idx}]">idx</Item>
					</If>
					<Exec>idx++</Exec>
				</Loop>
			</CustomListItems>
		</Expand>
	</Type>

	<Type Name="frost::HandleAlloc2T&lt;*&gt;">
		<DisplayString>{{ handles={m_numHandles}/{m_maxHandles} }}</DisplayString>
		<Expand>
			<ExpandedItem>*(frost::HandleAlloc2*)this</ExpandedItem>
		</Expand>
	</Type>

	<Type Name="frost::FixedStorageT&lt;*,*&gt;">
		<DisplayString>{{ Capacity={$T2} }}</DisplayString>
		<Expand>
			<ArrayItems>
				<Size>$T2</Size>
				<ValuePointer>($T1*)m_data</ValuePointer>
			</ArrayItems>
		</Expand>
	</Type>

	<Type Name="frost::DynamicStorageT&lt;*&gt;">
		<DisplayString Condition="m_ptr == 0">{{ empty }}</DisplayString>
		<DisplayString>{{ Capacity={m_capacity} ptr={(void*)m_ptr} }}</DisplayString>
		<Expand>
			<Item Name="[capacity]">m_capacity</Item>
			<Item Name="[allocator]">m_allocator</Item>
			<ArrayItems Condition="m_ptr != 0">
				<Size>m_capacity</Size>
				<ValuePointer>m_ptr</ValuePointer>
			</ArrayItems>
		</Expand>
	</Type>

	<Type Name="frost::StorageViewT&lt;*&gt;">
		<DisplayString>{{ count={m_term - m_ptr} }}</DisplayString>
		<Expand>
			<Item Name="[count]" ExcludeView="simple">m_term - m_ptr</Item>
			<Item Name="[ptr]" ExcludeView="simple">m_ptr</Item>
			<ArrayItems>
				<Size>m_term - m_ptr</Size>
				<ValuePointer>m_ptr</ValuePointer>
			</ArrayItems>
		</Expand>
	</Type>

	<Type Name="frost::BitArrayViewBase">
		<DisplayString Condition="m_ptr == 0">{{ empty }}</DisplayString>
		<DisplayString>{{ count={m_count} bytes={m_sizeInBytes} }}</DisplayString>
		<Expand>
			<Item Name="[count]">m_count</Item>
			<Item Name="[sizeInBytes]">m_sizeInBytes</Item>
			<Item Name="[ptr]">m_ptr</Item>
			<ArrayItems Condition="m_ptr != 0">
				<Size>m_sizeInBytes / 8</Size>
				<ValuePointer>m_ptr</ValuePointer>
			</ArrayItems>
		</Expand>
	</Type>

	<Type Name="frost::BitArray">
		<DisplayString Condition="m_ptr == 0">{{ empty }}</DisplayString>
		<DisplayString>{{ count={m_count} bytes={m_sizeInBytes} }}</DisplayString>
		<Expand>
			<Item Name="[count]">m_count</Item>
			<Item Name="[sizeInBytes]">m_sizeInBytes</Item>
			<Item Name="[allocator]">m_storage.m_allocator</Item>
			<Item Name="[capacity]">m_storage.m_capacity</Item>
			<ArrayItems Condition="m_ptr != 0">
				<Size>m_sizeInBytes / 8</Size>
				<ValuePointer>m_ptr</ValuePointer>
			</ArrayItems>
		</Expand>
	</Type>


	<Type Name="frost::MippedBitArrayBase">
		<DisplayString Condition="m_ptr == 0">{{ empty }}</DisplayString>
		<DisplayString>{{ count={m_count} bytes={m_sizeInBytes} }}</DisplayString>
		<Expand>
			<Item Name="[count]">m_count</Item>
			<Item Name="[sizeInBytes]">m_sizeInBytes</Item>
			<Item Name="[ptr]">m_ptr</Item>
			<Item Name="[mip]">m_mip,[(m_sizeInBytes/8+63)/64]</Item>
			<ArrayItems Condition="m_ptr != 0">
				<Size>m_sizeInBytes / 8</Size>
				<ValuePointer>m_ptr</ValuePointer>
			</ArrayItems>
		</Expand>
	</Type>

	<Type Name="frost::MippedBitArrayT&lt;*&gt;">
		<DisplayString Condition="m_ptr == 0">{{ empty }}</DisplayString>
		<DisplayString>{{ count={m_count} bytes={m_sizeInBytes} }}</DisplayString>
		<Expand>
			<ExpandedItem>*(frost::MippedBitArrayBase*)this</ExpandedItem>
		</Expand>
	</Type>

</AutoVisualizer>
