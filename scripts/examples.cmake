# Each examples/<name> directory is a separate executable linked to frost.
file(GLOB FROST_EXAMPLE_DIRS CONFIGURE_DEPENDS "${FROST_DIR}/examples/*")

foreach(FROST_EXAMPLE_DIR IN LISTS FROST_EXAMPLE_DIRS)
	if(NOT IS_DIRECTORY "${FROST_EXAMPLE_DIR}")
		continue()
	endif()

	file(GLOB_RECURSE FROST_EXAMPLE_SOURCES CONFIGURE_DEPENDS
		"${FROST_EXAMPLE_DIR}/*.c"
		"${FROST_EXAMPLE_DIR}/*.cpp"
	)
	if(NOT FROST_EXAMPLE_SOURCES)
		continue()
	endif()

	file(GLOB_RECURSE FROST_EXAMPLE_HEADERS CONFIGURE_DEPENDS
		"${FROST_EXAMPLE_DIR}/*.h"
		"${FROST_EXAMPLE_DIR}/*.inl"
	)

	get_filename_component(FROST_EXAMPLE_NAME "${FROST_EXAMPLE_DIR}" NAME)
	set(FROST_EXAMPLE_TARGET "example-${FROST_EXAMPLE_NAME}")
	add_executable(${FROST_EXAMPLE_TARGET} ${FROST_EXAMPLE_SOURCES} ${FROST_EXAMPLE_HEADERS})
	target_link_libraries(${FROST_EXAMPLE_TARGET} PRIVATE frost device)
	set_target_properties(${FROST_EXAMPLE_TARGET} PROPERTIES FOLDER "frost/examples")

	source_group(TREE "${FROST_EXAMPLE_DIR}" FILES ${FROST_EXAMPLE_SOURCES} ${FROST_EXAMPLE_HEADERS})
endforeach()
